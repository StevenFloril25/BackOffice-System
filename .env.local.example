# Copia este archivo a .env.local y complétalo con los datos del proyecto de
# Supabase (Project Settings -> API y Project Settings -> Database).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo servidor. Crear usuarios y restablecer contraseñas exige la service role
# de Supabase Auth. Va a Vercel como variable normal, NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Solo para scripts/migrate.mjs (cadena del Session pooler de Supabase).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
